# ------- Server -------
PORT=3000
# Allow your React frontend to call this API
CORS_ORIGIN=http://localhost:5173

# ------- WhatsApp -------
# "webjs"  = free, unofficial, works by scanning a QR code with your phone (whatsapp-web.js)
# "cloud"  = official Meta WhatsApp Cloud API (requires a Meta developer app + verified number)
WA_PROVIDER=webjs

# whatsapp-web.js drives WhatsApp Web inside a real Chrome/Chromium browser.
# Puppeteer's bundled Chrome download often fails (no disk space, proxy, offline),
# so point this at a Chrome or Edge that is already installed on the machine.
# Windows examples:
#   C:\Program Files\Google\Chrome\Application\chrome.exe
#   C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
# Leave blank to let the backend auto-detect Chrome/Edge in common locations.
PUPPETEER_EXECUTABLE_PATH=
# Set to true so `npm install` doesn't try to download Chromium.
PUPPETEER_SKIP_DOWNLOAD=true

# Only needed if WA_PROVIDER=cloud
WA_CLOUD_TOKEN=your-meta-permanent-or-temp-access-token
WA_CLOUD_PHONE_NUMBER_ID=your-phone-number-id
WA_CLOUD_VERIFY_TOKEN=any-random-string-you-choose
WA_CLOUD_API_VERSION=v20.0

# ------- Google Sheets -------
# Path to the service-account JSON key file you download from Google Cloud Console
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./google-service-account-key.json
# The spreadsheet ID from the sheet URL:
# https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
GOOGLE_SHEET_ID=your-google-spreadsheet-id

# ------- Business config -------
BUSINESS_NAME=Dental & Aesthetic Clinic
# comma separated list of services offered
SERVICES=Dental Consultation,Scaling & Polishing,Tooth Filling,Root Canal Treatment,Tooth Extraction,Teeth Whitening
# working hours shown to users as guidance only (not enforced)
WORKING_HOURS=10:00 - 20:00
